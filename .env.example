# PayPal SANDBOX credentials only. Never put a live credential in this project.
PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=your-sandbox-client-id-here
PAYPAL_CLIENT_SECRET=your-sandbox-client-secret-here
# AI explainer endpoint (OpenAI; key is server-side only, never in browser code)
AI_API_KEY=
# Optional: explainer model and API base override (defaults shown)
AI_MODEL=gpt-4o-mini
# AI_API_BASE=https://api.openai.com/v1
